/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://image.tmdb.org https://*.supabase.co; connect-src 'self' https://api.themoviedb.org https://www.wikidata.org https://*.supabase.co wss://*.supabase.co; frame-src https://www.youtube-nocookie.com; media-src 'self' blob:; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
